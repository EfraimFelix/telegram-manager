{
  "name": "telegram-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:infra",
    "test:unit": "vitest run",
    "test:infra": "tsx --test amplify/tests/*.test.ts",
    "test:watch": "vitest",
    "sandbox": "ampx sandbox",
    "backend:deploy": "ampx pipeline-deploy"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "^3.1136.0",
    "@aws-sdk/client-secrets-manager": "^3.1136.0",
    "@aws-sdk/client-sqs": "^3.1136.0",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@typesafe-ai/sdk": "^0.6.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.25",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.7",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.8.1",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "pnpm": {
    "overrides": {
      "@aws-amplify/backend-output-schemas>zod": "3.25.17"
    }
  }
}
