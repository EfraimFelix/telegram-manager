# Local PostgreSQL from compose.yaml.
DATABASE_URL=postgresql://postgres:local-development-only@localhost:5434/telegram_manager

# Local authentication only. Production reads the generated key from AWS Secrets Manager.
BETTER_AUTH_SECRET=replace-this-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Required only when testing TypeSafe/Jev locally.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# Required only when connecting a real Telegram bot locally. Use a public HTTPS tunnel.
WEBHOOK_BASE_URL=
TELEGRAM_SYSTEM_BOT_TOKEN=
